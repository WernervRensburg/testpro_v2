# Copy this file to .env.local for local development with `vercel dev`,
# and set the same variables in the Vercel project's dashboard for deploys.

# Required, from https://resend.com/api-keys after creating an account
RESEND_API_KEY=

# Optional, the "From" address the quote-request emails are sent as.
# Defaults to Resend's shared test sender if unset. Once testpro.co.za is
# verified with Resend (https://resend.com/domains), set this to something
# like: Testpro Website <quotes@testpro.co.za>
CONTACT_FROM_EMAIL=
